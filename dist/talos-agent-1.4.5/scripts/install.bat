@echo off
setlocal
cd /d "%~dp0\.."

REM ============================================================
REM  Talos Agent installer (Windows) -- one-click install + start
REM
REM    scripts\install.bat --server HOST:PORT --token TOKEN [--id CLIENT_ID]
REM    scripts\install.bat                       (reuse conf\agent.yml if present, else prompts)
REM    scripts\install.bat --server ... --silent (no prompts, no pause)
REM
REM  Steps:
REM    1. locate java
REM    2. write conf\agent.yml (skipped when it already exists and no
REM       explicit --server/--token/--id was passed; existing one is
REM       backed up to agent.yml.bak before a rewrite)
REM    3. register scheduled task TalosAgentWatchdog (every 5 minutes)
REM    4. start the agent once
REM
REM  Keep this file pure ASCII. Non-ASCII bytes shift cmd.exe's file
REM  offset after a codepage switch and corrupt command parsing.
REM ============================================================

set "ADDR="
set "PORT="
set "HTTPPORT="
set "TOKEN="
set "CID="
set "SILENT="
set "HAVE_SERVER="
set "EXPLICIT="

:args
if "%~1"=="" goto args_done
if /i "%~1"=="--server" (
  for /f "tokens=1,2 delims=:" %%a in ("%~2") do (
    set "ADDR=%%a"
    set "PORT=%%b"
  )
  set "HAVE_SERVER=1"
  set "EXPLICIT=1"
  shift
) else if /i "%~1"=="--http-port" (
  set "HTTPPORT=%~2"
  shift
) else if /i "%~1"=="--token" (
  set "TOKEN=%~2"
  set "EXPLICIT=1"
  shift
) else if /i "%~1"=="--id" (
  set "CID=%~2"
  set "EXPLICIT=1"
  shift
) else if /i "%~1"=="--silent" (
  set "SILENT=1"
) else if /i "%~1"=="--help" (
  goto usage
)
shift
goto args

:args_done
if "%ADDR%"=="" set "ADDR=localhost"
if "%PORT%"=="" set "PORT=9443"
if "%HTTPPORT%"=="" set "HTTPPORT=8080"
if "%CID%"=="" for /f "delims=" %%i in ('hostname') do set "CID=%%i"

REM Explicit args = reconfigure: rewrite conf\agent.yml as told.
REM Otherwise, an existing conf\agent.yml wins: reuse it as-is and
REM skip both the prompts and the rewrite (incremental install).
set "REUSE="
if not defined EXPLICIT if exist conf\agent.yml set "REUSE=1"

if defined REUSE goto reuse_config
if defined SILENT goto params_ready
if defined HAVE_SERVER goto params_ready

echo.
echo [Talos] Interactive setup - press Enter to accept the default.
set /p "IN=  server address [%ADDR%:%PORT%]: "
if not "%IN%"=="" for /f "tokens=1,2 delims=:" %%a in ("%IN%") do (set "ADDR=%%a" & set "PORT=%%b")
set /p "IN2=  enrollment token (optional): "
if not "%IN2%"=="" set "TOKEN=%IN2%"
set /p "IN3=  client id [%CID%]: "
if not "%IN3%"=="" set "CID=%IN3%"
echo.
goto params_ready

:reuse_config
REM Parse the existing config just for display; the file itself is kept.
for /f "tokens=2" %%a in ('findstr /r /c:"^  addr:" conf\agent.yml') do set "ADDR=%%a"
for /f "tokens=2" %%a in ('findstr /r /c:"^  port:" conf\agent.yml') do set "PORT=%%a"
for /f "tokens=2" %%a in ('findstr /r /c:"^  httpPort:" conf\agent.yml') do set "HTTPPORT=%%a"
for /f "tokens=2" %%a in ('findstr /r /c:"^  id:" conf\agent.yml') do set "CID=%%a"
for /f "tokens=2" %%a in ('findstr /r /c:"^  token:" conf\agent.yml') do set "TOKEN=%%a"
echo.
echo [Talos] Existing conf\agent.yml detected - reusing its settings.
echo [Talos] Pass --server/--token/--id to override, or delete the file for first-time setup.
echo.

:params_ready
echo [Talos] ============================================
echo [Talos]  Talos Agent installer
echo [Talos]  server : %ADDR%:%PORT%
echo [Talos]  client : %CID%
echo [Talos] ============================================

REM ---------- 1/4 locate java ----------
where java >nul 2>&1
if errorlevel 1 (
  echo [Talos] ERROR: java not found on PATH. Install JRE 17+ and retry.
  goto fail
)

if not exist talos-agent.jar (
  echo [Talos] ERROR: talos-agent.jar not found in %CD%
  echo [Talos] Copy talos-agent.jar, conf\ and scripts\ into the same directory.
  goto fail
)

REM ---------- 2/4 write conf\agent.yml ----------
if defined REUSE (
  echo [Talos] 2/4 conf\agent.yml already exists - keeping it untouched.
  goto watchdog
)
echo [Talos] 2/4 writing conf\agent.yml ...
if not exist conf mkdir conf
if exist conf\agent.yml (
  copy /y conf\agent.yml conf\agent.yml.bak >nul
  echo [Talos]      previous config backed up to conf\agent.yml.bak
)

REM YAML double-quoted scalars treat "\" as an escape, so backslashes in the
REM install path break conf parsing ("found unknown escape character").
REM Convert to forward slashes: D:\opt\... -> D:/opt/...
set "WS=%CD:\=/%"

(
echo # Talos Agent client config - generated by scripts/install.bat
echo # Field reference: docs\Talos_client_guide.txt
echo # Edit this file and restart the agent to apply changes.
echo.
echo server:
echo   addr: %ADDR%
echo   port: %PORT%
echo   # HTTP port of the console, used to download upgrade packages
echo   httpPort: %HTTPPORT%
echo.
echo client:
echo   id: %CID%
echo   token: %TOKEN%
echo   workspace: '%WS%/workspace'
echo   heartbeatSeconds: 10
echo   signSecret: ""
echo   # set to false to refuse remote silent upgrades on this machine
echo   allowUpgrade: true
echo.
echo agents:
echo   - backend: claude
echo     enabled: true
echo     model: claude-opus-4
echo     cmd: claude
echo     args: []
echo   - backend: cursor
echo     enabled: true
echo     model: cursor-pro
echo     cmd: cursor
echo     args: []
echo   - backend: codex
echo     enabled: false
echo     model: codex-1
echo     cmd: codex
echo     args: []
echo   - backend: codebuddy
echo     enabled: true
echo     model: cb-internal
echo     cmd: codebuddy
echo     args: []
echo.
echo log:
echo   dir: logs
) > conf\agent.yml
REM The interactive "set /p" captures the console codepage (GBK on zh-CN
REM Windows), but the JVM reads this file as UTF-8 - a Chinese client id
REM would arrive mojibake'd. Re-encode the file GBK -> UTF-8 (no-op for
REM pure-ASCII content; skipped silently if PowerShell is unavailable).
powershell -NoProfile -Command "try { $p='conf\agent.yml'; $c=[IO.File]::ReadAllText($p,[Text.Encoding]::GetEncoding(936)); [IO.File]::WriteAllText($p,$c,[Text.Encoding]::UTF8) } catch {}" >nul 2>&1
echo [Talos]      conf\agent.yml written

REM ---------- 3/4 register watchdog task ----------
:watchdog
echo [Talos] 3/4 registering scheduled task TalosAgentWatchdog ...
REM A per-user task (no /rl HIGHEST, no /ru) needs NO elevation and is enough
REM for keepalive: it fires every 5 minutes whenever the user is logged on.
REM /rl HIGHEST is what makes schtasks demand Administrator - try it last,
REM only for elevated contexts (RMM/SYSTEM) where the per-user task fails.
schtasks /create /tn "TalosAgentWatchdog" /sc minute /mo 5 /tr "\"%~dp0run-agent.bat\"" /f >nul 2>&1
if not errorlevel 1 (
  echo [Talos]      scheduled task registered - checks every 5 minutes.
  goto watchdog_done
)
schtasks /create /tn "TalosAgentWatchdog" /sc minute /mo 5 /tr "\"%~dp0run-agent.bat\"" /rl HIGHEST /f >nul 2>&1
if not errorlevel 1 (
  echo [Talos]      scheduled task registered ^(elevated^) - checks every 5 minutes.
  goto watchdog_done
)
echo [Talos]      WARNING: failed to register the task.
echo [Talos]      Keepalive disabled - the agent will NOT auto-restart on crash.
echo [Talos]      Corporate policy may block task registration; try Administrator.
:watchdog_done

REM ---------- 4/4 start now ----------
echo [Talos] 4/4 starting agent ...
REM Start-Process instead of "start": install.bat is often driven by an RMM or
REM a console-less parent, where "start" can fail silently.
powershell -NoProfile -Command "Start-Process -FilePath 'cmd.exe' -ArgumentList '/c','\"%~dp0run-agent.bat\"' -WindowStyle Hidden"
ping -n 6 127.0.0.1 >nul

powershell -NoProfile -Command "$p = Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'java.exe' -and $_.CommandLine -like '*talos-agent.jar*' }; if ($p) { foreach ($x in $p) { Write-Host ('[Talos]      agent running, PID ' + $x.ProcessId) } } else { Write-Host '[Talos]      agent not detected yet - check logs\agent.log' }"

echo [Talos] ============================================
echo [Talos]  Installed and started.
echo [Talos]    config  : %CD%\conf\agent.yml
echo [Talos]    log     : %CD%\logs\agent.log
echo [Talos]    status  : scripts\status.bat
echo [Talos]    stop    : scripts\stop.bat
echo [Talos]    upgrade : scripts\upgrade.bat
echo [Talos]    console : watch it online under "Clients"
echo [Talos]  Uninstall: scripts\uninstall.bat
echo [Talos] ============================================
if not defined SILENT pause >nul
exit /b 0

:fail
if not defined SILENT pause >nul
exit /b 1

:usage
echo Usage: scripts\install.bat --server HOST:PORT --token TOKEN [--id CLIENT_ID] [--http-port 8080] [--silent]
echo.
echo   --server     Talos server gRPC address, e.g. talos.yonyong.dev:9443
echo   --http-port  Talos console HTTP port for upgrade downloads, defaults to 8080
echo   --token      one-time enrollment token from the console
echo   --id         client id, defaults to this machine's hostname
echo   --silent     never prompt and never pause (for unattended deployment)
echo.
echo   With no arguments, an existing conf\agent.yml is reused as-is
echo   (incremental install). Delete it or pass --server/--token/--id
echo   to rewrite the config.
exit /b 0
